#!/bin/bash
# Idle timing control: screensaver + lock (stored in Omarchy shell.json,
# same fields OmaSettings uses) plus suspend-after-idle (a separate,
# self-owned hypridle instance + systemd --user service, since the shell
# has no native suspend-on-idle concept and the kbd-backlight hypridle
# instance gets fully regenerated/overwritten by omarchy-kbd-backlight).
#
# Usage:
#   omarchy-idle-tuner get
#   omarchy-idle-tuner set screensaver <seconds>
#   omarchy-idle-tuner set lock <seconds>
#   omarchy-idle-tuner set suspend <seconds|off>
#
# Suspend-after-idle is kept in sync with Omarchy's own Stay Awake toggle: a
# path unit watches ~/.local/state/omarchy/indicators/stay-awake and calls
# 'sync-awake' (below) on every change, stopping/starting the suspend service
# accordingly -- not an internal detail, this is the whole point: the two are
# meant to be called only from that path unit, not run by hand.

set -euo pipefail

SHELL_JSON="$HOME/.config/omarchy/shell.json"
SUSPEND_CONF="$HOME/.config/omarchy/idle-suspend.conf"
HYPRIDLE_SUSPEND_CONF="$HOME/.config/hypr/hypridle-suspend.conf"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
SUSPEND_UNIT="$SYSTEMD_USER_DIR/omarchy-idle-suspend.service"
SUSPEND_SERVICE_NAME="omarchy-idle-suspend.service"
INDICATORS_DIR="$HOME/.local/state/omarchy/indicators"
STAY_AWAKE_FILE="$INDICATORS_DIR/stay-awake"
AWAKE_WATCH_PATH_UNIT="$SYSTEMD_USER_DIR/omarchy-idle-suspend-awake-watch.path"
AWAKE_WATCH_SERVICE_UNIT="$SYSTEMD_USER_DIR/omarchy-idle-suspend-awake-watch.service"

[[ -f $SUSPEND_CONF ]] || printf 'SUSPEND_SECONDS=0\n' > "$SUSPEND_CONF"
# shellcheck disable=SC1090
source "$SUSPEND_CONF"
SUSPEND_SECONDS="${SUSPEND_SECONDS:-0}"

ensure_unit_installed() {
  mkdir -p "$SYSTEMD_USER_DIR"
  if [[ ! -f $SUSPEND_UNIT ]]; then
    cat > "$SUSPEND_UNIT" <<EOF
[Unit]
Description=Suspend after idle (Omarchy idle tuner)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hypridle -c %h/.config/hypr/hypridle-suspend.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
EOF
    systemctl --user daemon-reload
  fi
}

save_suspend_conf() {
  printf 'SUSPEND_SECONDS=%s\n' "$SUSPEND_SECONDS" > "$SUSPEND_CONF"
}

regenerate_hypridle_suspend() {
  mkdir -p "$(dirname "$HYPRIDLE_SUSPEND_CONF")"
  cat > "$HYPRIDLE_SUSPEND_CONF" <<EOF
# Suspend-after-idle. Managed by omarchy-idle-tuner -- edit via
# 'omarchy-idle-tuner set suspend <seconds|off>' rather than by hand; this
# file gets regenerated. Kept as its own hypridle instance/service, fully
# separate from the keyboard-backlight one, so it can't be silently wiped
# by omarchy-kbd-backlight regenerating its own config.
#
# No lock_cmd/before_sleep_cmd here: systemd-logind's PrepareForSleep hook
# (omarchy-sleep-lock.service) already locks the session before ANY
# suspend, regardless of what triggered it.
listener {
  timeout = $SUSPEND_SECONDS
  on-timeout = systemctl suspend
}
EOF
}

apply_suspend() {
  ensure_unit_installed
  if [[ $SUSPEND_SECONDS -le 0 ]]; then
    systemctl --user stop "$SUSPEND_SERVICE_NAME" 2>/dev/null || true
    systemctl --user disable "$SUSPEND_SERVICE_NAME" 2>/dev/null || true
    return
  fi
  regenerate_hypridle_suspend
  systemctl --user enable "$SUSPEND_SERVICE_NAME" >/dev/null
  ensure_awake_watch
  sync_awake
}

# Ties suspend-after-idle to Omarchy's own built-in "Stay Awake" toggle (the
# same one the bar indicator and idle lock/screensaver already respect), so
# the two move as one system instead of suspend running on its own clock
# regardless of what the user told the rest of the desktop. Called on every
# change to that toggle (via the path watcher below) and whenever the suspend
# timeout itself changes.
sync_awake() {
  if [[ $SUSPEND_SECONDS -le 0 ]]; then
    systemctl --user stop "$SUSPEND_SERVICE_NAME" 2>/dev/null || true
    return
  fi
  if [[ -f $STAY_AWAKE_FILE ]]; then
    systemctl --user stop "$SUSPEND_SERVICE_NAME" 2>/dev/null || true
  else
    systemctl --user start "$SUSPEND_SERVICE_NAME" 2>/dev/null || true
  fi
}

ensure_awake_watch() {
  mkdir -p "$SYSTEMD_USER_DIR" "$INDICATORS_DIR"
  if [[ ! -f $AWAKE_WATCH_SERVICE_UNIT ]]; then
    cat > "$AWAKE_WATCH_SERVICE_UNIT" <<EOF
[Unit]
Description=Sync suspend-after-idle with the Stay Awake toggle (Omarchy idle tuner)

[Service]
Type=oneshot
ExecStart=%h/.local/bin/omarchy-idle-tuner sync-awake
EOF
  fi
  if [[ ! -f $AWAKE_WATCH_PATH_UNIT ]]; then
    cat > "$AWAKE_WATCH_PATH_UNIT" <<EOF
[Unit]
Description=Watch the Stay Awake toggle for suspend-after-idle (Omarchy idle tuner)

[Path]
PathModified=%h/.local/state/omarchy/indicators
Unit=omarchy-idle-suspend-awake-watch.service

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
  fi
  systemctl --user enable --now omarchy-idle-suspend-awake-watch.path >/dev/null
}

edit_shell_json() {
  # All args except the last are extra jq flags/params (e.g. --argjson v 60);
  # the last arg is the filter itself.
  local tmp
  tmp="$(mktemp "${SHELL_JSON}.XXXXXX")"
  jq "$@" "$SHELL_JSON" > "$tmp"
  mv "$tmp" "$SHELL_JSON"
}

case "${1:-}" in
  sync-awake)
    sync_awake
    ;;
  get)
    screensaver=$(jq -r '.idle.screensaver // 150' "$SHELL_JSON")
    lock=$(jq -r '.idle.lock // 300' "$SHELL_JSON")
    printf 'SCREENSAVER=%s\nLOCK=%s\nSUSPEND=%s\n' "$screensaver" "$lock" "$SUSPEND_SECONDS"
    ;;
  set)
    case "${2:-}" in
      screensaver)
        edit_shell_json --argjson v "$3" '.idle = ((.idle // {}) | .screensaver = $v)'
        echo "$3"
        ;;
      lock)
        edit_shell_json --argjson v "$3" '.idle = ((.idle // {}) | .lock = $v)'
        echo "$3"
        ;;
      suspend)
        if [[ $3 == off ]]; then
          SUSPEND_SECONDS=0
        else
          SUSPEND_SECONDS="$3"
        fi
        save_suspend_conf
        apply_suspend
        echo "$SUSPEND_SECONDS"
        ;;
      *)
        echo "usage: omarchy-idle-tuner set {screensaver|lock|suspend} <value>" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "usage: omarchy-idle-tuner {get|set <field> <value>}" >&2
    exit 1
    ;;
esac
