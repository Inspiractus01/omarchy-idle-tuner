  // Idle timing: screensaver, lock, and suspend-after-idle. Backed by
  // ~/.local/bin/omarchy-idle-tuner.
  "trigger.idle-tuner": {"icon":"󰤄","label":"Idle Timing","aliases":["idle","sleep","suspend"],"description":"Screensaver, lock, and suspend after inactivity. Greyed out and paused while Stay Awake is on.","disabled":"[[ -f \"$HOME/.local/state/omarchy/indicators/stay-awake\" ]]"},

  "trigger.idle-tuner.screensaver": {"icon":"󰄄","label":"Screensaver After","title":"Screensaver After","aliases":["idle"],"description":"Paused while Stay Awake is on","disabled":"[[ -f \"$HOME/.local/state/omarchy/indicators/stay-awake\" ]]"},
  "trigger.idle-tuner.screensaver.30": {"icon":"󰄄","label":"30 sec","checked":"omarchy-idle-tuner get | grep -qx 'SCREENSAVER=30'","action":"omarchy-idle-tuner set screensaver 30","disabled":"[[ -f \"$HOME/.local/state/omarchy/indicators/stay-awake\" ]]"},
  "trigger.idle-tuner.screensaver.60": {"icon":"󰄄","label":"1 min","checked":"omarchy-idle-tuner get | grep -qx 'SCREENSAVER=60'","action":"omarchy-idle-tuner set screensaver 60","disabled":"[[ -f \"$HOME/.local/state/omarchy/indicators/stay-awake\" ]]"},
